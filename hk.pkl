amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Builtins.pkl"

local linters = new Mapping<String, Step> {
    ["check-added-large-files"] {
        check = "hk util check-added-large-files --maxkb=1024 {{files}}"
        glob = List("**/*")
        exclude = List("build/**")
    }
    ["check-merge-conflict"] {
        check = "hk util check-merge-conflict {{files}}"
        glob = List("**/*")
        exclude = List("build/**")
    }
    ["detect-private-key"] {
        check = "hk util detect-private-key {{files}}"
        glob = List("**/*")
        exclude = List("build/**")
    }
    ["end-of-file-fixer"] = (Builtins.newlines) {
        exclude = List("*.json", "build/**")
    }
    ["fix-byte-order-marker"] = (Builtins.byte_order_marker) {
        exclude = List("build/**")
    }
    ["trailing-whitespace"] = (Builtins.trailing_whitespace) {
        exclude = List("build/**", "docs/index.md")
    }
    ["gofmt"] {
        check = "gofmt -l {{files}}"
        fix = "gofmt -w {{files}}"
        glob = List("**/*.go")
    }
    ["golangci-lint"] {
        check = "golangci-lint run ./..."
        glob = List("**/*.go", "go.mod", "go.sum")
    }
    ["go-mod-tidy"] {
        check = "go mod tidy -diff"
        fix = "go mod tidy"
        glob = List("**/*.go", "go.mod", "go.sum")
    }
    ["zizmor"] {
        check = "zizmor .github/workflows"
        glob = List(".github/workflows/**/*.yml", ".github/workflows/**/*.yaml")
    }
}

hooks {
    ["pre-commit"] {
        fix = true
        stash = "git"
        steps {
            ...linters
        }
    }
    ["check"] {
        steps {
            ...linters
        }
    }
    ["fix"] {
        fix = true
        steps {
            ...linters
        }
    }
}
